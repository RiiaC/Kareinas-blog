views:
  - type: table
    name: where I have lived
    filters:
      and:
        - file.path.startsWith("content/list of locations I have lived")
    order:
      - file.name
      - country
      - my_legal_age
      - extra_childhood_age
      - type_of_home
      - lived_with
    sort: []
    columnSize:
      note.extra_childhood_age: 192
  - type: cards
    name: Cards with images
    filters:
      and:
        - file.hasProperty("image")
    sort:
      - property: file.name
        direction: DESC
    image: note.image
  - type: table
    name: table
    filters:
      or:
        - file.folder.contains("Journal")
    order:
      - file.name
      - image
      - projects
      - weight(kg)
      - high_temp(°C)
      - location
      - low_temp(°C)
      - training
    sort:
      - property: projects
        direction: ASC
      - property: file.name
        direction: DESC
      - property: weight(kg)
        direction: DESC
      - property: location
        direction: ASC
      - property: high temp (C)
        direction: ASC
    columnSize:
      file.name: 186
      note.location: 88
      note.training: 108
      note.image: 88
  - type: table
    name: recipies
    filters:
      and:
        - file.path.contains("Recipes")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: ASC
  - type: table
    name: Posts
    filters:
      or:
        - file.folder == "public/Journal/2026/2026-January"
        - file.folder == "content/Journal/2026/2026-02 February"
        - file.folder == "content/Journal/2026/2026-03 March"
        - file.folder == "content/Journal/2026/2026-04 April"
        - file.folder == "content/Journal/2026/2026-05 May"
        - file.folder == "content/Journal/2026/2026-06 June"
    order:
      - file.name
      - location
      - country
      - projects
    sort:
      - property: file.name
        direction: ASC
      - property: location
        direction: ASC
    columnSize:
      note.location: 798
